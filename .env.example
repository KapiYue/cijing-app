# Copy this file to .env and replace every placeholder with the value for the
# environment you are running. Only .env.example is committed to Git.

# Public Supabase values embedded into the iOS app and Chrome extension at build time.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Trusted Flask server only. Never expose this value to a client.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY
PORT=8000

# Supabase Edge Functions / OpenRouter.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=qwen/qwen3.6-flash

# Compatibility values supplied by legacy/local or hosted Supabase environments.
# Normally leave these empty in .env unless your Supabase tooling requires them.
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEYS=
